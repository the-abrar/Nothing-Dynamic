<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dynamic_island_bubble"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/pill_background"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- App Icon -->
    <ImageView
        android:id="@+id/app_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@mipmap/ic_launcher"
        android:tint="@color/iconTint" />

    <!-- Text and status indicators container -->
    <LinearLayout
        android:id="@+id/text_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_title"
            android:textAppearance="@style/TextAppearance.Dynamic.Title" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_subtitle"
            android:textAppearance="@style/TextAppearance.Dynamic.Subtitle" />
    </LinearLayout>

    <!-- Status indicator hooks (placeholder) -->
    <View
        android:id="@+id/status_indicator"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/status_indicator_bg"
        android:layout_marginStart="8dp" />

</LinearLayout>
